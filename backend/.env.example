# Anthropic
ANTHROPIC_API_KEY=your_key_here

# Microsoft Graph (Outlook + Calendar)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Redirect URI must match your Spotify app dashboard AND the backend callback path.
# Default backend callback: http://127.0.0.1:8000/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# AnkiConnect (default — change only if you moved the port)
ANKICONNECT_URL=http://localhost:8765

# UWorld scraper (optional — only needed if you use the QBank widget)
# Find your course ID in the URL after logging into UWorld:
#   https://apps.uworld.com/courseapp/usmle/v50/en-US/dashboard/<COURSE_ID>
# QBank ID: 1 = Step 1, 2 = Step 2 CK, etc.
# Username/password are an optional headless-login fallback; the scraper prefers
# reusing your already-logged-in browser session over re-authenticating.
JARVIS_UWORLD_COURSE_ID=
JARVIS_UWORLD_QBANK_ID=2
UWORLD_USERNAME=
UWORLD_PASSWORD=
